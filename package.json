{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "api:dev": "tsx watch server/index.ts",
        "api:start": "tsx server/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "auth:migrate": "npx better-auth migrate --config ./server/auth.ts --yes",
        "seed": "tsx server/scripts/seed.ts"
    },
    "devDependencies": {
        "@better-auth/cli": "^1.4.21",
        "@tailwindcss/vite": "^4.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.15.5",
        "concurrently": "^9.0.1",
        "drizzle-kit": "^0.31.10",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "better-auth": "^1.4.21",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.41.0",
        "express": "^5.2.1",
        "pg": "^8.16.3",
        "zod": "^4.3.5"
    }
}
